<?xml version="1.0"?>
<!--
  robot.srdf — MoveIt-обвязка того же robot.urdf. Кинематика, углы и знаки
  берутся из URDF; здесь только группы, стартовая поза и пары звеньев,
  которые касаются друг друга по построению.
-->
<robot name="minipulator">

  <!-- Рука: joint1..joint5. Губка в цепь не входит — цепь заканчивается на link5. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="link5"/>
  </group>

  <!-- Отдельная группа, ровно один сустав: раскрытие губки. -->
  <group name="gripper">
    <joint name="gripper_joint"/>
  </group>

  <!-- Поза платы после сброса: сервы 90/90/0/40/0/0. -->
  <group_state name="start" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="-0.1745"/>
    <joint name="joint4" value="0.8727"/>
    <joint name="joint5" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="1.5708"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0"/>
  </group_state>

  <!-- Первая проверка руки на железе: база уходит на +10°, остальное на месте. -->
  <group_state name="turn" group="arm">
    <joint name="joint1" value="0.1745"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="-0.1745"/>
    <joint name="joint4" value="0.8727"/>
    <joint name="joint5" value="0"/>
  </group_state>

  <!-- Соседние звенья соприкасаются в шарнире всегда — иначе планировщик
       не сдвинется с места. Губки друг с другом не отключены: их столкновение
       как раз и означает «закрылись в объект». -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="gripper_finger" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="fixed_jaw" reason="Adjacent"/>
  <!-- Неподвижная губка стоит в URDF на глаз и при раскрытии пересекается
       с подвижной; на железе они разнесены. Эту пару не проверяем. -->
  <disable_collisions link1="gripper_finger" link2="fixed_jaw" reason="Default"/>

</robot>
